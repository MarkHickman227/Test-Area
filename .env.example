# PrivateCanvas local/dev configuration.
# Copy to .env and replace secrets before running. Never commit real keys.

APP_ENV=development
APP_NAME=PrivateCanvas
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string
ENCRYPTION_KEY=replace-with-fernet-key
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

DATABASE_URL=postgresql+psycopg://privatecanvas:privatecanvas@postgres:5432/privatecanvas
REDIS_URL=redis://redis:6379/0

STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=privatecanvas-outputs
MINIO_SECURE=false
STORAGE_LOCAL_PATH=./data/storage

MAIL_BACKEND=smtp
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@localhost
MAIL_CONSOLE=true

AGE_VERIFICATION_PROVIDER=sandbox
AGE_VERIFICATION_WEBHOOK_SECRET=change-me-webhook
AGE_VERIFICATION_API_URL=
AGE_VERIFICATION_API_KEY=
ALLOW_SANDBOX_AGE_VERIFY=true

PAYMENTS_ENABLED=false
PAYMENTS_PROCESSOR_ATTESTED=false
PAYMENT_PROVIDER=none
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com
GENERATION_BACKEND=mock
COMFYUI_URL=http://comfyui:8188
COMFYUI_TIMEOUT_SECONDS=120
JOB_EXECUTION=inline
REQUIRE_MFA_PRIVILEGED=true
ALLOW_DEV_MFA_BYPASS=true

DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=change-me-admin
DEV_USER_EMAIL=adult@example.com
DEV_USER_PASSWORD=change-me-user

SIGNED_URL_TTL_SECONDS=120
SESSION_TTL_SECONDS=86400
QUEUE_MAX_DEPTH=20
JOB_TIMEOUT_SECONDS=180
INVITE_ONLY=false
BLOCKED_COUNTRIES=
AUTH_RATE_LIMIT_PER_MINUTE=20
GENERATE_RATE_LIMIT_PER_MINUTE=12

CSRF_COOKIE_NAME=pc_csrf
SESSION_COOKIE_NAME=pc_session
COOKIE_SECURE=false
