# Staging secrets. Copy to .env on the private host. Never commit real keys.
# The API will refuse to boot until placeholders are replaced.

APP_ENV=staging
APP_NAME=PrivateCanvas
APP_BASE_URL=https://staging.example.invalid
API_BASE_URL=https://staging.example.invalid
SECRET_KEY=replace-with-32-plus-random-characters
ENCRYPTION_KEY=replace-with-fernet-key

DATABASE_URL=postgresql+psycopg://privatecanvas:replace-db-password@postgres:5432/privatecanvas
REDIS_URL=redis://redis:6379/0

STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-minio-user
MINIO_SECRET_KEY=replace-minio-secret
MINIO_BUCKET=privatecanvas-outputs
MINIO_SECURE=false

MAIL_BACKEND=smtp
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@localhost
MAIL_CONSOLE=false

AGE_VERIFICATION_PROVIDER=http
AGE_VERIFICATION_API_URL=https://age-provider.example.invalid
AGE_VERIFICATION_API_KEY=replace-age-api-key
AGE_VERIFICATION_WEBHOOK_SECRET=replace-age-webhook-secret
ALLOW_SANDBOX_AGE_VERIFY=false

PAYMENTS_ENABLED=false
PAYMENTS_PROCESSOR_ATTESTED=false
PAYMENT_PROVIDER=none
PAYMENT_WEBHOOK_SECRET=replace-payment-webhook

GENERATION_BACKEND=mock
JOB_EXECUTION=celery
REQUIRE_MFA_PRIVILEGED=true
ALLOW_DEV_MFA_BYPASS=false
INVITE_ONLY=true
COOKIE_SECURE=true
