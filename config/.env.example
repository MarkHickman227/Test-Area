APP_ENV=production
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost,http://127.0.0.1

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
DATABASE_URL=postgresql://postgres.project-ref:replace-with-db-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

ANTHROPIC_API_KEY=replace-with-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6

PERPLEXITY_API_KEY=replace-with-perplexity-api-key
PERPLEXITY_MODEL=sonar-pro

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Twice-daily discovery (Europe/London by default: 08:00 and 20:00)
SCHEDULER_ENABLED=true
DISCOVERY_SCHEDULE_MODE=twice_daily
DISCOVERY_TIMES=08:00,20:00
DISCOVERY_TIMEZONE=Europe/London
# Used only when DISCOVERY_SCHEDULE_MODE=interval
DISCOVERY_INTERVAL_MINUTES=720

# Optional: require Authorization: Bearer <token> for POST /api/pipeline/run
PIPELINE_TRIGGER_TOKEN=

# Auto-apply jobs that score 60+ against the full CV
AUTO_APPLY=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
APPLY_FROM_EMAIL=
