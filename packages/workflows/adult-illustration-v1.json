{
  "workflow_id": "adult-illustration-v1",
  "workflow_version": "1.0.0",
  "compatible_model_profile_id": "adult-illustration-v1",
  "output_node_id": "9",
  "expected_output_types": ["image/png"],
  "content_policy_requirement_level": "adult_strict",
  "cost_multiplier": 1.0,
  "allowed_variable_fields": [
    "positive_prompt",
    "negative_prompt",
    "seed",
    "width",
    "height",
    "batch_count",
    "preset_values",
    "job_id",
    "user_id"
  ],
  "parameter_bounds": {
    "width": { "enum": [768, 1024, 1152] },
    "height": { "enum": [768, 1024, 1152] },
    "batch_count": { "min": 1, "max": 4 },
    "seed": { "min": 0, "max": 9223372036854775807 }
  },
  "fixed_graph": {
    "note": "Pinned template only. Users never submit this graph. Real ComfyUI node wiring lives on GPU workers.",
    "nodes": {
      "1": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "approved-illustration-v1.safetensors" } },
      "2": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{positive_prompt}}", "clip": ["1", 1] } },
      "3": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{negative_prompt}}", "clip": ["1", 1] } },
      "4": { "class_type": "EmptyLatentImage", "inputs": { "width": "{{width}}", "height": "{{height}}", "batch_size": "{{batch_count}}" } },
      "5": {
        "class_type": "KSampler",
        "inputs": {
          "seed": "{{seed}}",
          "steps": "{{preset.steps}}",
          "cfg": "{{preset.cfg}}",
          "sampler_name": "{{preset.sampler}}",
          "scheduler": "{{preset.scheduler}}",
          "denoise": 1,
          "model": ["1", 0],
          "positive": ["2", 0],
          "negative": ["3", 0],
          "latent_image": ["4", 0]
        }
      },
      "6": { "class_type": "VAEDecode", "inputs": { "samples": ["5", 0], "vae": ["1", 2] } },
      "9": { "class_type": "SaveImage", "inputs": { "images": ["6", 0], "filename_prefix": "pc-{{job_id}}" } }
    }
  }
}
